# Copy to .env and fill in real values. Never commit .env.
TS_SERVER_NAME=My TeamSpeak Server
TS_QUERY_API_KEY=               #To get api key run this when connected to your server via ssh: apikeyadd scope=manage lifetime=0
TS_HTTP_SERVER_IP=127.0.0.1
TS_HTTP_SERVER_PORT=10080
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
DISCORD_MESSAGE_ID=
